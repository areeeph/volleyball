<div id="app" class="text-lg">
  <div class="bg-blue-800 text-white h-9 min-w-55 mb-1 rounded-lg" :class="score_width">
    <div class="flex items-center h-9 justify-between">
      <div class="flex items-center py-1 pl-3">
        <h2 id="team1-name">{{ team1?.name }}</h2>
      </div>
      <div class="flex items-center space-x-3">
        <div class="flex items-center h-9 py-1">
          <img
            id="team1-logo"
            class="h-7 w-7 rounded-full"
            :src="team1?.logo || '/images/blank.jpg'"
            alt=""
          />
        </div>
        
        <div v-for="set in team1_sets" :key="set.id"
          class="m-0 w-9 h-9 bg-white text-blue-700 font-semibold flex items-center justify-center last:rounded-r-lg last:bg-red-600 last:text-white"
        >
          <h3 id="team1-score">{{ set.score }}</h3>
        </div>
      </div>
    </div>
  </div>

  <div class="bg-blue-800 text-white h-9 mb-1 rounded-lg min-w-55" :class="score_width">
    <div class="flex items-center h-9 justify-between">
      <div class="flex items-center py-1 pl-3">
        <h2 id="team2-name">{{ team2?.name }}</h2>
      </div>
      <div class="flex items-center space-x-3">
        <div class="flex items-center h-9 py-1">
          <img
            id="team2-logo"
            class="h-7 w-7 rounded-full"
            :src="team2?.logo || '/images/blank.jpg'"
            alt=""
          />
        </div>
        
        <div v-for="set in team2_sets" :key="set.id"
          class="m-0 w-9 h-9 bg-white text-blue-700 font-semibold flex items-center justify-center last:rounded-r-lg last:bg-red-600 last:text-white"
        >
          <h3 id="team2-score">{{ set.score }}</h3>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const { createApp, ref, onMounted, computed } = Vue;

  createApp({
    setup() {
      //const socket = io("http://localhost:7065");
      const socket = io("https://volley.aliareef.com");


      const team1 = ref(null);
      const team2 = ref(null);
      const sets = ref([]);
      const team1_sets = ref([
        {
          team_id: 1,
          score: 0,
        }
      ]);
      const team2_sets = ref([
        {
          team_id: 2,
          score: 0,
        }
      ]); 


      

      const score_width = computed(() => {
        if(team1_sets.value.length == 5 || team2_sets.value.length == 5) {
          return 'w-90';
        } else if(team1_sets.value.length == 4 || team2_sets.value.length == 4) {
          return 'w-80';
        } else if(team1_sets.value.length == 3 || team2_sets.value.length  == 3) {
          return 'w-70';
        } else if(team1_sets.value.length == 2 || team2_sets.value.length == 2) {
          return 'w-64';
        }else {
          return 'w-55';
        }
      });


      socket.on("DataUpdated", async (data) => {
        console.log("Score updated:", data);
        await fetchData(data)
      });

      const createSet = async () => {
        try {
          const data = {
            set: 1
          }
          const response = await fetch("/api/create-set", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
            },
            body: JSON.stringify(data),
          });

          if (response.ok) {
            console.log("Set created successfully");
            await fetchData();
          } else {
            console.error("Failed to create set");
          }
        } catch (error) {
          console.error("Error:", error);
        }
      };


      const fetchData = async (data) => {
        try {
          

          sets.value = data.sets;
          team1.value = data.team1;
          team2.value = data.team2;

          if(sets.value.length > 0){
            team1_sets.value = sets.value.filter((set) => set.team_id === team1.value.id);
            team2_sets.value = sets.value.filter((set) => set.team_id === team2.value.id);
          }else{
            await createSet();
          }

          console.log(team1_sets.value);
          console.log(data);

        } catch (error) {
          console.error("Error:", error);
        } 
      };

      onMounted(async () => {
        const response = await fetch("/api");
const data = await response.json();
        await fetchData(data);
      });

      return {
        team1,
        team2,
        team1_sets,
        team2_sets,
        score_width
      };
    },
  }).mount("#app");
</script>
