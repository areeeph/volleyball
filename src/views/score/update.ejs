<div class="mx-auto max-w-lg mt-5 ">
  <!-- Team 1 -->
  <div class="rounded-2xl border border-gray-200 bg-gray-50 p-5 mb-5">
    <div class="mb-5 flex items-center gap-3">
      <div
        class="flex h-10 w-10 items-center justify-center rounded-full bg-blue-100 font-bold text-blue-700"
      >
        1
      </div>

      <div>
        <h3 class="font-semibold text-gray-900">Team 1</h3>
        <p class="text-xs text-gray-500">First team</p>
      </div>
    </div>

    <div class="space-y-5">
      <!-- Team Name -->
      <div>
        <label
          for="team1_name"
          class="mb-2 block text-sm font-medium text-gray-700"
        >
          Team Name
        </label>

        <input
          type="text"
          id="team1_name"
          name="team1_name"
          value="<%= score.team1_name %>"
          required
          class="block w-full rounded-xl border border-gray-300 bg-white px-4 py-3 text-sm text-gray-900 outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10"
        />
      </div>

      <!-- Score -->
      <div>
        <label class="mb-2 block text-sm font-medium text-gray-700">
          Score
        </label>

        <div class="flex items-center gap-2">
          <button
            type="button"
            onclick="changeScore('team1_score', -1)"
            class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-gray-300 bg-white text-2xl font-semibold text-gray-700 shadow-sm transition hover:bg-gray-100 active:scale-95"
          >
            −
          </button>

          <input
            type="number"
            id="team1_score"
            name="team1_score"
            value="<%= score.team1_score %>"
            min="0"
            required
            class="h-12 min-w-0 flex-1 rounded-xl border border-gray-300 bg-white px-4 text-center text-2xl font-bold text-gray-900 outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10"
          />

          <button
            type="button"
            onclick="changeScore('team1_score', 1)"
            class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-gray-900 text-2xl font-semibold text-white shadow-sm transition hover:bg-gray-800 active:scale-95"
          >
            +
          </button>
        </div>
      </div>

      <!-- Sets -->
      <div>
        <label class="mb-2 block text-sm font-medium text-gray-700">
          Sets Won
        </label>

        <div class="flex items-center gap-2">
          <button
            type="button"
            onclick="changeScore('team1_set', -1)"
            class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-gray-300 bg-white text-xl font-semibold text-gray-700 hover:bg-gray-100 active:scale-95"
          >
            −
          </button>

          <input
            type="number"
            id="team1_set"
            name="team1_set"
            value="<%= score.team1_set %>"
            min="0"
            required
            class="h-10 min-w-0 flex-1 rounded-lg border border-gray-300 bg-white px-3 text-center text-lg font-bold text-gray-900 outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-500/10"
          />

          <button
            type="button"
            onclick="changeScore('team1_set', 1)"
            class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-gray-900 text-xl font-semibold text-white hover:bg-gray-800 active:scale-95"
          >
            +
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Team 2 -->
  <div class="rounded-2xl border border-gray-200 bg-gray-50 p-5 mb-5">
    <div class="mb-5 flex items-center gap-3">
      <div
        class="flex h-10 w-10 items-center justify-center rounded-full bg-red-100 font-bold text-red-700"
      >
        2
      </div>

      <div>
        <h3 class="font-semibold text-gray-900">Team 2</h3>
        <p class="text-xs text-gray-500">Second team</p>
      </div>
    </div>

    <div class="space-y-5">
      <!-- Team Name -->
      <div>
        <label
          for="team2_name"
          class="mb-2 block text-sm font-medium text-gray-700"
        >
          Team Name
        </label>

        <input
          type="text"
          id="team2_name"
          name="team2_name"
          value="<%= score.team2_name %>"
          required
          class="block w-full rounded-xl border border-gray-300 bg-white px-4 py-3 text-sm text-gray-900 outline-none focus:border-red-500 focus:ring-4 focus:ring-red-500/10"
        />
      </div>

      <!-- Score -->
      <div>
        <label class="mb-2 block text-sm font-medium text-gray-700">
          Score
        </label>

        <div class="flex items-center gap-2">
          <button
            type="button"
            onclick="changeScore('team2_score', -1)"
            class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-gray-300 bg-white text-2xl font-semibold text-gray-700 shadow-sm transition hover:bg-gray-100 active:scale-95"
          >
            −
          </button>

          <input
            type="number"
            id="team2_score"
            name="team2_score"
            value="<%= score.team2_score %>"
            min="0"
            required
            class="h-12 min-w-0 flex-1 rounded-xl border border-gray-300 bg-white px-4 text-center text-2xl font-bold text-gray-900 outline-none focus:border-red-500 focus:ring-4 focus:ring-red-500/10"
          />

          <button
            type="button"
            onclick="changeScore('team2_score', 1)"
            class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-gray-900 text-2xl font-semibold text-white shadow-sm transition hover:bg-gray-800 active:scale-95"
          >
            +
          </button>
        </div>
      </div>

      <!-- Sets -->
      <div>
        <label class="mb-2 block text-sm font-medium text-gray-700">
          Sets Won
        </label>

        <div class="flex items-center gap-2">
          <button
            type="button"
            onclick="changeScore('team2_set', -1)"
            class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-gray-300 bg-white text-xl font-semibold text-gray-700 hover:bg-gray-100 active:scale-95"
          >
            −
          </button>

          <input
            type="number"
            id="team2_set"
            name="team2_set"
            value="<%= score.team2_set %>"
            min="0"
            required
            class="h-10 min-w-0 flex-1 rounded-lg border border-gray-300 bg-white px-3 text-center text-lg font-bold text-gray-900 outline-none focus:border-red-500 focus:ring-4 focus:ring-red-500/10"
          />

          <button
            type="button"
            onclick="changeScore('team2_set', 1)"
            class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-gray-900 text-xl font-semibold text-white hover:bg-gray-800 active:scale-95"
          >
            +
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Actions -->
  <div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
    <button
      onclick="reset()"
      class="inline-flex items-center justify-center rounded-xl border border-gray-300 bg-white px-5 py-3 text-sm font-semibold text-gray-700 shadow-sm transition hover:bg-gray-50"
    >
      Reset
    </button>
    <button
      onclick="update()"
      type="button"
      class="inline-flex items-center justify-center rounded-xl bg-gray-900 px-6 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-gray-800 focus:outline-none focus:ring-4 focus:ring-gray-900/20"
    >
      Save Changes
    </button>
  </div>
</div>

<script>
  function changeScore(inputId, amount) {
    const input = document.getElementById(inputId);

    if (!input) return;

    const currentValue = parseInt(input.value) || 0;
    const min = parseInt(input.min) || 0;

    const newValue = Math.max(min, currentValue + amount);

    input.value = newValue;
    update();
  }

  function update() {
    const team1_name = document.getElementById("team1_name").value;
    const team1_score = parseInt(document.getElementById("team1_score").value);
    const team1_set = parseInt(document.getElementById("team1_set").value);

    const team2_name = document.getElementById("team2_name").value;
    const team2_score = parseInt(document.getElementById("team2_score").value);
    const team2_set = parseInt(document.getElementById("team2_set").value);

    const data = JSON.stringify({
      team1_name,
      team1_score,
      team1_set,
      team2_name,
      team2_score,
      team2_set,
    });

    console.log("Data to send:", data);
    fetch("/api/update", {
      method: "PUT",
      headers: {
        "Content-Type": "application/json",
      },
      body: data,
    })
      .then((response) => {
        if (response.ok) {
          //window.location.href = "/scores";
        } else {
          console.error("Failed to update score");
        }
      })
      .catch((error) => {
        console.error("Error:", error);
      });
  }

  function reset() {
    fetch("/api/reset", {
      method: "GET",
    })
      .then((response) => {
        if (response.ok) {
          window.location.href = "/update";
        } else {
          console.error("Failed to update score");
        }
      })
      .catch((error) => {
        console.error("Error:", error);
      });
  }
</script>
