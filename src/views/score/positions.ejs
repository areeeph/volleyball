<div id="app" class="mx-auto py-5 px-5">
  <div class="relative w-100 rounded bg-slate-600 text-gray-100">
    <img
      class="rounded h-24 object-cover w-100"
      src="/images/template1.png"
      alt=""
    />
    <div class="p-5 absolute top-0 left-0 w-full h-full">
      <div class="flex flex-col justify-between h-full">
        <h2
          class="text-left text-gray-200  mb-4 uppercase text-sm font-semibold"
        >
          {{ position.position }}
        </h2>
        <div class="flex items-center space-x-3">
          <img src="/images/comets.png" class="w-6 h-6" />
          <h2 class="text-center uppercase text-sm font-semibold">
            {{ position.name }}
          </h2>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const { createApp, ref, onMounted, computed } = Vue;

  createApp({
    setup() {
      const position = ref({
        position: "Queen of the tournament",
        name: "Fathimath Afaaf",
      });
      const socket = io("http://localhost:7065");
      //const socket = io("https://volley.aliareef.com");

      socket.on("Position", async (data) => {
        console.log("Score updated:", data);
        console.log(data);
        position.value = data;
      });

      return {
        position,
      };
    },
  }).mount("#app");
</script>
