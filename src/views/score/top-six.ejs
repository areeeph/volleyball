<div id="app" class="mx-auto py-5 px-5">
  <div class="w-70 rounded bg-white p-5 flex justify-center">
    <div>
      <h2 class="text-center uppercase mb-1 font-semibold">TMIVT2026 Women's Division</h2>
      <h2 class="text-center mb-5 uppercase text-sm font-semibold">Top six Players</h2>
      <ul>
        <li class="mb-2 text-lg">{{ names?.name1 }}</li>
        <li class="mb-2 text-lg">{{ names?.name2 }}</li>
        <li class="mb-2 text-lg">{{ names?.name3 }}</li>
        <li class="mb-2 text-lg">{{ names?.name4 }}</li>
        <li class="mb-2 text-lg">{{ names?.name5 }}</li>
        <li class="mb-2 text-lg">{{ names?.name6 }}</li>
      </ul>
    </div>
  </div>
</div>

<script>
  const { createApp, ref, onMounted, computed } = Vue;

  createApp({
    setup() {
      const names = ref({
        name1: "Name 1",
        name2: "Name 2",
        name3: "Name 3",
        name4: "Name 4",
        name5: "Name 5",
        name6: "Name 6",
      });
      const socket = io("http://localhost:7065");
      //const socket = io("https://volley.aliareef.com");

      socket.on("TopSix", async (data) => {
        console.log("Score updated:", data);
        names.value = data;
        console.log(names.value);
      });

      return {
        names,
      };
    },
  }).mount("#app");
</script>
